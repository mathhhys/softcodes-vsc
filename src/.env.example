# Softcodes Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to version control

# =================================================================
# REQUIRED CONFIGURATION
# =================================================================

# Supabase Configuration (REQUIRED)
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_token_here
SUPABASE_ANON_KEY=your_anon_jwt_token_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt_token_here

# Clerk Authentication (REQUIRED for auth features)
# Get these from your Clerk dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
CLERK_SECRET_KEY=sk_live_your_secret_key_here
CLERK_BASE_URL=https://your-clerk-domain.clerk.accounts.dev

# =================================================================
# OPTIONAL CONFIGURATION
# =================================================================

# OpenRouter API (Optional - users can provide their own keys)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OAuth Configuration (Optional)
VSCODE_OAUTH_CLIENT_ID=your_oauth_client_id_here

# Credit System Configuration (Optional - defaults provided)
CREDIT_USD_RATE=0.014
CREDIT_LOW_THRESHOLD=10
CREDIT_MAX_DEDUCTION=1000
CREDIT_BADGE_UPDATE_INTERVAL=1000
CREDIT_ENABLE_NOTIFICATIONS=true
CREDIT_NOTIFICATION_THRESHOLD=10
CREDIT_SHOW_ANIMATIONS=true

# Application URLs (Optional - defaults provided)
APP_MAIN_URL=https://www.softcodes.ai
ROO_CODE_API_URL=https://www.softcodes.ai

# Security Configuration (Optional - defaults provided)
RATE_LIMITING_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=1000
CORS_ALLOWED_ORIGINS=https://softcodes.ai
CORS_ALLOW_CREDENTIALS=true

# Development and Debug Configuration (Optional)
DEBUG_ENABLED=false
LOG_LEVEL=info
ENABLE_PERF_MONITORING=false
USE_MOCK_SERVICES=false

# Feature Flags (Optional - defaults provided)
FEATURE_CREDIT_SYSTEM=true
FEATURE_CREDIT_BADGE=true
FEATURE_OAUTH=true
FEATURE_JWT_VALIDATION=true
FEATURE_AUTOCOMPLETE=true
FEATURE_GHOST_TEXT=true
FEATURE_TELEMETRY=true
FEATURE_ERROR_REPORTING=true

# Google Services (Optional - default provided)
GEMINI_CLIENT_ID=your_google_oauth_client_id_here